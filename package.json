{
  "name": "pontofoko",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate.mjs",
    "db:sessions": "node scripts/apply-sql.mjs supabase/sessions-rpc.sql",
    "db:adjust": "node scripts/apply-sql.mjs supabase/session-adjust.sql",
    "qa": "node scripts/qa-all.mjs && node scripts/qa-journey.mjs && npx --yes tsx scripts/qa-metrics.ts",
    "qa:ui": "node scripts/qa-ui.mjs",
    "qa:cleanup": "node scripts/cleanup-qa.mjs",
    "db:reset": "node scripts/reset-data.mjs",
    "db:users": "node scripts/setup-users.mjs",
    "db:user": "node scripts/create-user.mjs",
    "deploy": "next build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^15.26.0",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
